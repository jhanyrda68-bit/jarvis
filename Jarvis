
{"name":"build-jarvis","permissions":{"contents":"write"},"jobs":{"apk":{"runs-on":"ubuntu-latest","steps":[{"uses":"actions/checkout@v4"},{"uses":"actions/setup-java@v4","with":{"distribution":"temurin","java-version":"17"}},{"uses":"gradle/actions/setup-gradle@v4","with":{"gradle-version":"8.9"}},{"name":"Write project","run":"cat > settings.gradle <<'JARVIS_EOF'\npluginManagement { repositories { google(); mavenCentral(); gradlePluginPortal() } }\ndependencyResolutionManagement { repositories { google(); mavenCentral() } }\nrootProject.name = \"Jarvis\"\ninclude ':app'\nJARVIS_EOF\ncat > build.gradle <<'JARVIS_EOF'\nplugins {\n    id 'com.android.application' version '8.5.2' apply false\n    id 'org.jetbrains.kotlin.android' version '1.9.24' apply false\n}\nJARVIS_EOF\ncat > gradle.properties <<'JARVIS_EOF'\norg.gradle.jvmargs=-Xmx2g -Dfile.encoding=UTF-8\nandroid.nonTransitiveRClass=true\nJARVIS_EOF\nmkdir -p app\ncat > app/build.gradle <<'JARVIS_EOF'\nplugins {\n    id 'com.android.application'\n    id 'org.jetbrains.kotlin.android'\n}\nandroid {\n    namespace 'ir.jarvis.app'\n    compileSdk 34\n    defaultConfig {\n        applicationId \"ir.jarvis.app\"\n        minSdk 26\n        targetSdk 34\n        versionCode 1\n        versionName \"0.1\"\n    }\n    compileOptions {\n        sourceCompatibility JavaVersion.VERSION_17\n        targetCompatibility JavaVersion.VERSION_17\n    }\n    kotlinOptions { jvmTarget = '17' }\n}\nJARVIS_EOF\nmkdir -p app/src/main\ncat > app/src/main/AndroidManifest.xml <<'JARVIS_EOF'\n<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<manifest xmlns:android=\"http://schemas.android.com/apk/res/android\">\n    <uses-permission android:name=\"android.permission.RECORD_AUDIO\"/>\n    <uses-permission android:name=\"android.permission.READ_CONTACTS\"/>\n    <uses-permission android:name=\"android.permission.INTERNET\"/>\n    <queries>\n        <intent>\n            <action android:name=\"android.intent.action.MAIN\"/>\n            <category android:name=\"android.intent.category.LAUNCHER\"/>\n        </intent>\n        <intent><action android:name=\"android.speech.RecognitionService\"/></intent>\n        <intent><action android:name=\"android.intent.action.TTS_SERVICE\"/></intent>\n    </queries>\n    <application\n        android:label=\"\u062c\u0627\u0631\u0648\u06cc\u0633\"\n        android:allowBackup=\"false\"\n        android:theme=\"@android:style/Theme.DeviceDefault.NoActionBar\">\n        <activity\n            android:name=\".MainActivity\"\n            android:exported=\"true\"\n            android:windowSoftInputMode=\"adjustResize\">\n            <intent-filter>\n                <action android:name=\"android.intent.action.MAIN\"/>\n                <category android:name=\"android.intent.category.LAUNCHER\"/>\n            </intent-filter>\n        </activity>\n    </application>\n</manifest>\nJARVIS_EOF\nmkdir -p app/src/main/java/ir/jarvis/app\ncat > app/src/main/java/ir/jarvis/app/MainActivity.kt <<'JARVIS_EOF'\npackage ir.jarvis.app\n\nimport android.Manifest\nimport android.app.Activity\nimport android.content.Intent\nimport android.content.pm.PackageManager\nimport android.graphics.Color\nimport android.graphics.Typeface\nimport android.graphics.drawable.GradientDrawable\nimport android.net.Uri\nimport android.os.Bundle\nimport android.os.Handler\nimport android.os.Looper\nimport android.provider.ContactsContract\nimport android.provider.Settings\nimport android.speech.RecognitionListener\nimport android.speech.RecognizerIntent\nimport android.speech.SpeechRecognizer\nimport android.speech.tts.TextToSpeech\nimport android.speech.tts.UtteranceProgressListener\nimport android.view.View\nimport android.view.WindowManager\nimport android.widget.Button\nimport android.widget.EditText\nimport android.widget.LinearLayout\nimport android.widget.ScrollView\nimport android.widget.TextView\nimport java.net.URLEncoder\nimport java.util.Locale\n\nclass MainActivity : Activity() {\n    private val green = Color.parseColor(\"#2DFF6A\")\n    private val bg = Color.parseColor(\"#030805\")\n    private val h = Handler(Looper.getMainLooper())\n    private lateinit var logView: TextView\n    private lateinit var scroll: ScrollView\n    private lateinit var input: EditText\n    private lateinit var micBtn: Button\n    private var sr: SpeechRecognizer? = null\n    private var tts: TextToSpeech? = null\n    private var ttsOk = false\n    private var active = false\n    private var speaking = false\n    private var awakeUntil = 0L\n    private var contacts: List<Pair<String, String>> = emptyList()\n\n    private val wake = Regex(\"(\u062c\u0627\u0631\u0648\u06cc\u0633|\u062c\u0627\u0631\u0648\u0633|\u062c\u0627\u0631\u06cc\u0633|\u062c\u0627\u0631 \u0648\u06cc\u0633|\u0698\u0627\u0631\u0648\u0633|\u062c\u0627\u0648\u06cc\u0633|jarvis)\", RegexOption.IGNORE_CASE)\n    private val stopWords = setOf(\"\u0628\u0647\", \"\u0628\u0627\", \"\u0631\u0627\", \"\u0631\u0648\", \"\u0644\u0637\u0641\u0627\", \"\u0628\u0631\u0646\u0627\u0645\u0647\", \"\u0628\u0627\u0632\", \"\u06a9\u0646\", \"\u06a9\u0646\u06cc\u062f\", \"\u0627\u062c\u0631\u0627\", \"\u0628\u06cc\u0627\u0631\", \"\u0628\u0627\u0644\u0627\", \"\u0632\u0646\u06af\", \"\u0628\u0632\u0646\", \"\u0628\u0632\u0646\u06cc\u062f\", \"\u062a\u0645\u0627\u0633\", \"\u0628\u06af\u06cc\u0631\", \"\u0628\u06af\u06cc\u0631\u06cc\u062f\", \"open\", \"call\")\n    private val webStop = setOf(\"\u06cc\u0648\u062a\u06cc\u0648\u0628\", \"\u06af\u0648\u06af\u0644\", \"\u062f\u0631\", \"\u062a\u0648\", \"\u062a\u0648\u06cc\", \"\u0628\u0631\u0627\u0645\", \"\u0628\u0631\u0627\u06cc\u0645\", \"\u067e\u06cc\u062f\u0627\", \"\u06a9\u0646\", \"\u06a9\u0646\u06cc\u062f\", \"\u062c\u0633\u062a\u062c\u0648\", \"\u0633\u0631\u0686\", \"\u0628\u06af\u0631\u062f\", \"\u0628\u0628\u06cc\u0646\", \"\u0631\u0627\", \"\u0631\u0648\", \"\u0644\u0637\u0641\u0627\", \"\u0628\u0632\u0646\", \"youtube\", \"google\", \"\u062f\u0631\u0628\u0627\u0631\u0647\")\n    private val alias = mapOf(\n        \"\u0648\u0627\u062a\u0633\u0627\u067e\" to \"com.whatsapp\", \"\u0648\u0627\u062a\u0633 \u0627\u067e\" to \"com.whatsapp\", \"whatsapp\" to \"com.whatsapp\",\n        \"\u062a\u0644\u06af\u0631\u0627\u0645\" to \"org.telegram.messenger\", \"\u0627\u06cc\u0646\u0633\u062a\u0627\u06af\u0631\u0627\u0645\" to \"com.instagram.android\",\n        \"\u0627\u06cc\u0646\u0633\u062a\u0627\" to \"com.instagram.android\", \"\u06cc\u0648\u062a\u06cc\u0648\u0628\" to \"com.google.android.youtube\",\n        \"\u06a9\u0631\u0648\u0645\" to \"com.android.chrome\", \"\u0645\u0631\u0648\u0631\u06af\u0631\" to \"com.android.chrome\",\n        \"\u0627\u06cc\u062a\u0627\" to \"ir.eitaa.messenger\", \"\u0628\u0644\u0647\" to \"ir.nasim\", \"\u0631\u0648\u0628\u06cc\u06a9\u0627\" to \"ir.resaneh1.iptv\",\n        \"\u062a\u06cc\u06a9 \u062a\u0627\u06a9\" to \"com.zhiliaoapp.musically\"\n    )\n\n    private fun styled(b: Button) {\n        val d = GradientDrawable()\n        d.setStroke(2, green)\n        d.setColor(Color.TRANSPARENT)\n        b.background = d\n        b.setTextColor(green)\n        b.typeface = Typeface.MONOSPACE\n    }\n\n    override fun onCreate(savedInstanceState: Bundle?) {\n        super.onCreate(savedInstanceState)\n        window.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)\n        val root = LinearLayout(this)\n        root.orientation = LinearLayout.VERTICAL\n        root.setBackgroundColor(bg)\n        root.setPadding(24, 24, 24, 24)\n        root.fitsSystemWindows = true\n\n        val title = TextView(this)\n        title.text = \"J.A.R.V.I.S\"\n        title.setTextColor(green)\n        title.textSize = 24f\n        title.typeface = Typeface.MONOSPACE\n        root.addView(title)\n\n        logView = TextView(this)\n        logView.setTextColor(green)\n        logView.textSize = 16f\n        logView.typeface = Typeface.MONOSPACE\n        logView.textDirection = View.TEXT_DIRECTION_FIRST_STRONG\n        logView.setPadding(16, 16, 16, 16)\n        scroll = ScrollView(this)\n        val box = GradientDrawable()\n        box.setStroke(2, green)\n        box.setColor(Color.parseColor(\"#07120A\"))\n        scroll.background = box\n        scroll.addView(logView)\n        val lp = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, 0, 1f)\n        lp.topMargin = 16\n        lp.bottomMargin = 16\n        root.addView(scroll, lp)\n\n        val row = LinearLayout(this)\n        row.orientation = LinearLayout.HORIZONTAL\n        input = EditText(this)\n        input.hint = \"> \u0641\u0631\u0645\u0627\u0646 \u06cc\u0627 \u0646\u0627\u0645 \u0628\u0631\u0646\u0627\u0645\u0647\"\n        input.setTextColor(green)\n        input.setHintTextColor(Color.parseColor(\"#2D9950\"))\n        input.typeface = Typeface.MONOSPACE\n        input.setSingleLine(true)\n        row.addView(input, LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f))\n        val send = Button(this)\n        send.text = \">\"\n        styled(send)\n        send.setOnClickListener {\n            val t = input.text.toString().trim()\n            if (t.isNotEmpty()) {\n                input.setText(\"\")\n                exec(t)\n            }\n        }\n        row.addView(send)\n        root.addView(row)\n\n        micBtn = Button(this)\n        micBtn.text = \"START\"\n        styled(micBtn)\n        micBtn.setOnClickListener { toggle() }\n        root.addView(micBtn)\n        setContentView(root)\n\n        tts = TextToSpeech(this) { st ->\n            if (st == TextToSpeech.SUCCESS) {\n                val r = tts?.setLanguage(Locale(\"fa\", \"IR\")) ?: TextToSpeech.LANG_NOT_SUPPORTED\n                ttsOk = r >= TextToSpeech.LANG_AVAILABLE\n                tts?.setOnUtteranceProgressListener(object : UtteranceProgressListener() {\n                    override fun onStart(id: String?) {}\n                    override fun onDone(id: String?) { h.post { doneSpeaking() } }\n                    override fun onError(id: String?) { h.post { doneSpeaking() } }\n                })\n                h.post {\n                    if (!ttsOk) log(\"JARVIS: \", \"\u0635\u062f\u0627\u06cc \u0641\u0627\u0631\u0633\u06cc \u0631\u0648\u06cc \u06af\u0648\u0634\u06cc \u0646\u06cc\u0633\u062a\u061b \u0641\u0639\u0644\u0627\u064b \u062c\u0648\u0627\u0628\u200c\u0647\u0627 \u0641\u0642\u0637 \u0646\u0648\u0634\u062a\u0647 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f.\")\n                }\n            }\n        }\n        log(\"JARVIS: \", \"\u0622\u0645\u0627\u062f\u0647\u200c\u0627\u0645. START \u0631\u0627 \u0628\u0632\u0646 \u0648 \u0628\u06af\u0648 \u00ab\u062c\u0627\u0631\u0648\u06cc\u0633\u00bb.\")\n        loadContacts()\n    }\n\n    override fun onDestroy() {\n        super.onDestroy()\n        sr?.destroy()\n        tts?.shutdown()\n    }\n\n    private fun now(): Long = System.currentTimeMillis()\n\n    private fun log(who: String, t: String) {\n        logView.append(who + t + \"\\n\")\n        scroll.post { scroll.fullScroll(View.FOCUS_DOWN) }\n    }\n\n    private fun norm(s: String): String = s\n        .replace('\u064a', '\u06cc').replace('\u0643', '\u06a9')\n        .replace(Regex(\"[\\\\u064B-\\\\u065F]\"), \"\")\n        .replace('\\u200c', ' ')\n        .replace(Regex(\"[.,\u060c\u061f?!\u061b]\"), \" \")\n        .replace(Regex(\"\\\\s+\"), \" \")\n        .trim().lowercase()\n\n    private fun has(q: String, k: String): Boolean = (\" $q \").contains(\" ${norm(k)} \")\n\n    private fun toggle() {\n        if (active) {\n            stopAll()\n            return\n        }\n        if (checkSelfPermission(Manifest.permission.RECORD_AUDIO) != PackageManager.PERMISSION_GRANTED) {\n            requestPermissions(arrayOf(Manifest.permission.RECORD_AUDIO, Manifest.permission.READ_CONTACTS), 1)\n        } else {\n            startAll()\n        }\n    }\n\n    override fun onRequestPermissionsResult(code: Int, perms: Array<out String>, res: IntArray) {\n        super.onRequestPermissionsResult(code, perms, res)\n        loadContacts()\n        if (checkSelfPermission(Manifest.permission.RECORD_AUDIO) == PackageManager.PERMISSION_GRANTED) {\n            startAll()\n        } else {\n            log(\"JARVIS: \", \"\u0628\u062f\u0648\u0646 \u0627\u062c\u0627\u0632\u0647 \u0645\u06cc\u06a9\u0631\u0648\u0641\u0648\u0646 \u0646\u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u0645 \u06af\u0648\u0634 \u0628\u062f\u0647\u0645.\")\n        }\n    }\n\n    private fun startAll() {\n        if (!SpeechRecognizer.isRecognitionAvailable(this)) {\n            log(\"JARVIS: \", \"\u062a\u0634\u062e\u06cc\u0635 \u06af\u0641\u062a\u0627\u0631 \u0631\u0648\u06cc \u0627\u06cc\u0646 \u06af\u0648\u0634\u06cc \u062f\u0631 \u062f\u0633\u062a\u0631\u0633 \u0646\u06cc\u0633\u062a.\")\n            return\n        }\n        active = true\n        micBtn.text = \"STOP\"\n        say(\"\u0633\u0644\u0627\u0645\u060c \u0645\u0646 \u062c\u0627\u0631\u0648\u06cc\u0633 \u0647\u0633\u062a\u0645. \u0628\u0641\u0631\u0645\u0627\u06cc\u06cc\u062f.\")\n        listen()\n    }\n\n    private fun stopAll() {\n        active = false\n        micBtn.text = \"START\"\n        sr?.cancel()\n        tts?.stop()\n        speaking = false\n        log(\"JARVIS: \", \"\u0645\u062a\u0648\u0642\u0641 \u0634\u062f.\")\n    }\n\n    private fun listen() {\n        if (!active || speaking) return\n        if (sr == null) {\n            sr = SpeechRecognizer.createSpeechRecognizer(this)\n            sr?.setRecognitionListener(listener)\n        }\n        val i = Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH)\n        i.putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM)\n        i.putExtra(RecognizerIntent.EXTRA_LANGUAGE, \"fa-IR\")\n        i.putExtra(RecognizerIntent.EXTRA_PARTIAL_RESULTS, false)\n        sr?.startListening(i)\n    }\n\n    private val listener = object : RecognitionListener {\n        override fun onReadyForSpeech(p: Bundle?) {}\n        override fun onBeginningOfSpeech() {}\n        override fun onRmsChanged(v: Float) {}\n        override fun onBufferReceived(b: ByteArray?) {}\n        override fun onEndOfSpeech() {}\n        override fun onEvent(t: Int, p: Bundle?) {}\n        override fun onPartialResults(p: Bundle?) {}\n        override fun onError(e: Int) {\n            if (e == SpeechRecognizer.ERROR_INSUFFICIENT_PERMISSIONS) {\n                stopAll()\n                return\n            }\n            h.postDelayed({ listen() }, 700)\n        }\n        override fun onResults(r: Bundle?) {\n            val l = r?.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION)\n            if (l != null && l.isNotEmpty()) handle(l[0])\n            h.postDelayed({ listen() }, 500)\n        }\n    }\n\n    private fun say(t: String) {\n        log(\"JARVIS: \", t)\n        if (!ttsOk) return\n        speaking = true\n        sr?.cancel()\n        tts?.speak(t, TextToSpeech.QUEUE_FLUSH, null, \"u\")\n        h.postDelayed({ if (speaking) doneSpeaking() }, (6000 + t.length * 130).toLong())\n    }\n\n    private fun doneSpeaking() {\n        if (!speaking) return\n        speaking = false\n        awakeUntil = now() + 20000\n        if (active) listen()\n    }\n\n    private fun handle(raw: String) {\n        if (speaking) return\n        val n = norm(raw)\n        val m = wake.find(n)\n        if (m != null) {\n            val c = n.substring(m.range.last + 1).trim()\n            awakeUntil = now() + 10000\n            if (c.isEmpty()) {\n                say(\"\u0628\u0644\u0647\u060c \u0628\u0641\u0631\u0645\u0627\u06cc\u06cc\u062f.\")\n                return\n            }\n            exec(c)\n        } else if (now() < awakeUntil) {\n            exec(n)\n        }\n    }\n\n    private fun loadContacts() {\n        if (checkSelfPermission(Manifest.permission.READ_CONTACTS) != PackageManager.PERMISSION_GRANTED) return\n        val out = ArrayList<Pair<String, String>>()\n        val c = contentResolver.query(\n            ContactsContract.CommonDataKinds.Phone.CONTENT_URI,\n            arrayOf(ContactsContract.CommonDataKinds.Phone.DISPLAY_NAME, ContactsContract.CommonDataKinds.Phone.NUMBER),\n            null, null, null\n        )\n        c?.use {\n            while (it.moveToNext()) out.add(Pair(it.getString(0) ?: \"\", it.getString(1) ?: \"\"))\n        }\n        contacts = out\n    }\n\n    private fun launchables(): List<Pair<String, String>> {\n        val i = Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER)\n        return packageManager.queryIntentActivities(i, 0)\n            .map { Pair(it.loadLabel(packageManager).toString(), it.activityInfo.packageName) }\n    }\n\n    private fun openApp(q: String): Boolean {\n        if (has(q, \"\u062a\u0646\u0638\u06cc\u0645\u0627\u062a\") || has(q, \"settings\")) {\n            say(\"\u0628\u0627\u0632 \u06a9\u0631\u062f\u0646 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a\")\n            startActivity(Intent(Settings.ACTION_SETTINGS))\n            return true\n        }\n        var pkg: String? = null\n        for ((k, v) in alias) {\n            if (has(q, k)) { pkg = v; break }\n        }\n        if (pkg == null) {\n            for ((lab, p) in launchables()) {\n                val l = norm(lab)\n                if (l.isNotEmpty() && (q == l || has(q, l))) { pkg = p; break }\n            }\n        }\n        if (pkg == null) return false\n        val li = packageManager.getLaunchIntentForPackage(pkg) ?: return false\n        say(\"\u0628\u0627\u0632 \u06a9\u0631\u062f\u0646 $q\")\n        startActivity(li)\n        return true\n    }\n\n    private fun web(url: String, msg: String) {\n        say(msg)\n        startActivity(Intent(Intent.ACTION_VIEW, Uri.parse(url)))\n    }\n\n    private fun exec(cmd: String) {\n        log(\"> \", cmd)\n        awakeUntil = now() + 15000\n        val t = norm(cmd)\n        val words = t.split(\" \").filter { it.isNotEmpty() }\n        val q = words.filter { it !in stopWords }.joinToString(\" \")\n        val qq = words.filter { it !in webStop }.joinToString(\" \")\n        val isCall = t.contains(\"\u0632\u0646\u06af\") || t.contains(\"\u062a\u0645\u0627\u0633\") || has(t, \"call\")\n        val hasQ = t.contains(\"\u062e\u0628\u0631\") || t.contains(\"\u062c\u0633\u062a\u062c\u0648\") || t.contains(\"\u0633\u0631\u0686\") || t.contains(\"\u067e\u06cc\u062f\u0627\") || t.contains(\"\u0628\u06af\u0631\u062f\")\n        val yt = t.contains(\"\u06cc\u0648\u062a\u06cc\u0648\u0628\") || t.contains(\"youtube\")\n        val gg = t.contains(\"\u06af\u0648\u06af\u0644\") || t.contains(\"google\")\n\n        if (isCall) {\n            if (q.isEmpty()) { say(\"\u0646\u0627\u0645 \u0631\u0627 \u0646\u0634\u0646\u06cc\u062f\u0645.\"); return }\n            val m = contacts.firstOrNull { val n = norm(it.first); n == q || n.contains(q) || q.contains(n) }\n            if (m == null) {\n                say(\"\u0645\u062e\u0627\u0637\u0628\u06cc \u0628\u0647 \u0646\u0627\u0645 $q \u067e\u06cc\u062f\u0627 \u0646\u0634\u062f.\")\n            } else {\n                say(\"\u062a\u0645\u0627\u0633 \u0628\u0627 \" + m.first)\n                startActivity(Intent(Intent.ACTION_DIAL, Uri.parse(\"tel:\" + m.second)))\n            }\n            return\n        }\n        if (hasQ && (yt || gg)) {\n            if (yt) {\n                web(\"https://www.youtube.com/results?search_query=\" + URLEncoder.encode(if (qq.isEmpty()) \"\u0627\u062e\u0628\u0627\u0631 \u0627\u0645\u0631\u0648\u0632\" else qq, \"UTF-8\"), \"\u062f\u0631 \u06cc\u0648\u062a\u06cc\u0648\u0628 \u062c\u0633\u062a\u062c\u0648 \u0645\u06cc\u200c\u06a9\u0646\u0645.\")\n            } else {\n                web(\"https://www.google.com/search?q=\" + URLEncoder.encode(qq, \"UTF-8\"), \"\u062f\u0631 \u06af\u0648\u06af\u0644 \u062c\u0633\u062a\u062c\u0648 \u0645\u06cc\u200c\u06a9\u0646\u0645.\")\n            }\n            return\n        }\n        if (openApp(q)) return\n        if (gg || t.contains(\"\u062c\u0633\u062a\u062c\u0648\") || t.contains(\"\u0633\u0631\u0686\") || t.contains(\"\u0628\u06af\u0631\u062f\")) {\n            web(\"https://www.google.com/search?q=\" + URLEncoder.encode(qq, \"UTF-8\"), \"\u062f\u0631 \u06af\u0648\u06af\u0644 \u062c\u0633\u062a\u062c\u0648 \u0645\u06cc\u200c\u06a9\u0646\u0645.\")\n            return\n        }\n        if (t.contains(\"\u062e\u0628\u0631\")) {\n            web(\"https://news.google.com/?hl=fa&gl=IR&ceid=IR:fa\", \"\u0627\u062e\u0628\u0627\u0631 \u0631\u0627 \u0628\u0627\u0632 \u0645\u06cc\u200c\u06a9\u0646\u0645.\")\n            return\n        }\n        say(\"\u0628\u0631\u0627\u06cc \u0627\u06cc\u0646 \u0633\u0624\u0627\u0644 \u0647\u0646\u0648\u0632 \u062c\u0648\u0627\u0628\u06cc \u0646\u062f\u0627\u0631\u0645. \u0641\u0639\u0644\u0627\u064b \u0641\u0642\u0637 \u062f\u0633\u062a\u0648\u0631\u0647\u0627 \u0631\u0627 \u0627\u0646\u062c\u0627\u0645 \u0645\u06cc\u200c\u062f\u0647\u0645.\")\n    }\n}\nJARVIS_EOF\n"},{"name":"Build APK","run":"gradle assembleDebug --no-daemon --stacktrace"},{"name":"Publish APK","uses":"softprops/action-gh-release@v2","with":{"tag_name":"build-${{ github.run_number }}","name":"Jarvis build ${{ github.run_number }}","files":"app/build/outputs/apk/debug/app-debug.apk"}}]}},"on":{"push":{},"workflow_dispatch":{}}}
